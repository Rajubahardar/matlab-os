# MATLAB Expert Agent Configuration
# Copy to .env and modify as needed
# Phase 4 Verified - Local AI OS V1 Release Candidate

# MATLAB Integration
MATLAB_MCP_HOST=localhost
MATLAB_MCP_PORT=31515
MATLAB_ENGINE_AVAILABLE=true
MATLAB_ENGINE_PATH=D:\Apps\Matlab\bin\matlab.exe

# Database
DB_PATH=./data/matlab_agent.db

# Experiment Tracking
EXPERIMENT_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/matlab_agent.log

# Approval Controls
REQUIRE_APPROVAL=true