@echo off
python -c "
with open('e:\matlab os\start.ps1', 'w') as f:
    f.write('# Local AI OS V1 Two-Command Launcher\n')
    f.write('# Usage: cd \"E:\\matlab os\" .\\start.ps1\n')
    f.write('#\n')
    f.write('# This launcher starts Local AI OS V1 with two PowerShell commands.\n')
    f.write('# It automatically starts the MATLAB MCP server, waits for it to be healthy,\n')
    f.write('# and opens the browser interface.\n')
    f.write('\n')
    f.write('# Resolve MATLAB path - check hardcoded path first, then config.toml\n')
    f.write('\$MATLAB_ENGINE_PATH = \"D:/Apps/Matlab/bin/matlab.exe\"\n')
    f.write('if (-not (Test-Path \"\$MATLAB_ENGINE_PATH\")) {\n')
    f.write('    \$configPath = \"e:\\matlab os\\config.toml\"\n')
    f.write('    if (Test-Path \$configPath) {\n')
    f.write('        \$configContent = Get-Content \$configPath\n')
    f.write('        \$engineMatch = \$configContent -match \"^\\\\s*engine_path\\\\s*=\\\\s*\\\"(.+)\\\"\"\n')
    f.write('        if (\$engineMatch) {\n')
    f.write('            \$MATLAB_ENGINE_PATH = \$matches[1]\n')
    f.write('        }\n')
    f.write('    }\n')
    f.write('}\n')
    f.write('\n')
    f.write('if (-not (Test-Path \"\$MATLAB_ENGINE_PATH\")) {\n')
    f.write('    Write-Error \"Failed to start MCP server. Check that MATLAB is installed at \$MATLAB_ENGINE_PATH\"\n')
    f.write('    exit 1\n')
    f.write('}\n')
    f.write('\n')
    f.write('Write-Host \"Starting MATLAB MCP server...\"\n')
    f.write('\n')
    f.write('# MCP configuration from config.toml (V1 Release Candidate)\n')
    f.write('\$MCP_HOST = \"localhost\"\n')
    f.write('\$MCP_PORT = 31515\n')
    f.write('\$MCP_URL = \"http://\${MCP_HOST}:\$MCP_PORT\"\n')
    f.write('\$mcpUrl = \"\$MCP_URL/health\"\n')
    f.write('\n')
    f.write('# Check if MCP server is already running\n')
    f.write('\$mcpHealthy = \$false\n')
    f.write('\n')
    f.write('try {\n')
    f.write('    \$response = Invoke-WebRequest -Uri \$mcpUrl -Method Get -TimeoutSec 5\n')
    f.write('    \$mcpHealthy = \$response.StatusCode -eq 200\n')
    f.write('} catch {\n')
    f.write('    # MCP server not running - will start it\n')
    f.write('}\n')
    f.write('\n')
    f.write('# Start MATLAB MCP server if not already healthy\n')
    f.write('if (-not \$mcpHealthy) {\n')
    f.write('    Start-Process -FilePath \$MATLAB_ENGINE_PATH -ArgumentList \"-r\", \"startMCPServer; exit\" -NoNewWindow | Out-Null\n')
    f.write('    # Wait for server to become healthy\n')
    f.write('    \$maxWait = 60\n')
    f.write('    \$waited = 0\n')
    f.write('    while (\$waited -lt \$maxWait) {\n')
    f.write('        try {\n')
    f.write('            \$response = Invoke-WebRequest -Uri \$mcpUrl -Method Get -TimeoutSec 5\n')
    f.write('            if (\$response.StatusCode -eq 200) {\n')
    f.write('                \$mcpHealthy = \$true\n')
    f.write('                break\n')
    f.write('            }\n')
    f.write('        } catch {\n')
    f.write('            # Server not yet ready\n')
    f.write('        }\n')
    f.write('        Start-Sleep -Seconds 2\n')
    f.write('        \$waited += 2\n')
    f.write('    }\n')
    f.write('}\n')
    f.write('\n')
    f.write('# Open browser to the interface\n')
    f.write('if (\$mcpHealthy) {\n')
    f.write('    Write-Host \"Opening browser to \$MCP_URL ...\"\n')
    f.write('    # -Verb RunAs unnecessarily elevates the browser; launch without elevation for local URLs\n')
    f.write('    Start-Process -Uri \$MCP_URL\n')
    f.write('\n')
    f.write('    # Display status\n')
    f.write('    Write-Host \"Local AI OS V1 is running.\"\n')
    f.write('    Write-Host \"Interface: \$MCP_URL\"\n')
    f.write('    Write-Host \"Press Ctrl+C to stop the MATLAB MCP server and exit.\"\n')
    f.write('\n')
    f.write('    # Wait for Ctrl+C\n')
    f.write('    while (\$true) {\n')
    f.write('        Start-Sleep -Seconds 5\n')
    f.write('    }\n')
    f.write('} else {\n')
    f.write('    Write-Error \"Failed to start MCP server. Check that MATLAB is installed at \$MATLAB_ENGINE_PATH\"\n')
    f.write('    exit 1\n')
    f.write('}\n')
"
echo Done rewriting start.ps1
pause